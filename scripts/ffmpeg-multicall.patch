@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <string.h>
+
+#include "cmdutils.h"
+
+const char *program_name = "ffmpeg";
+int program_birth_year = 2000;
+
+static int probe_mode;
+
+void show_help_default(const char *opt, const char *arg)
+{
+    if (probe_mode)
+        ffprobe_show_help_default(opt, arg);
+    else
+        ffmpeg_show_help_default(opt, arg);
+}
+
+int main(int argc, char **argv)
+{
+    const char *name = strrchr(argv[0], '/');
+
+    /* Both command names resolve to this same executable. */
+    probe_mode = !strcmp(name ? name + 1 : argv[0], "ffprobe");
+    if (probe_mode) {
+        program_name = "ffprobe";
+        program_birth_year = 2007;
+        return ffprobe_main(argc, argv);
+    }
+    return ffmpeg_main(argc, argv);
+}
